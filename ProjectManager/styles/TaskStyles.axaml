<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
            <StackPanel>
                <Button Classes="Add">+</Button>
                <Button>all</Button>
            </StackPanel>
        </Border>
    </Design.PreviewWith>
    <!-- normal button -->
    <Style Selector="Button">
       <Setter Property="BorderBrush" Value="Transparent"></Setter>
        <Setter Property="Background" Value="#CCE0FF"></Setter>
        <Setter Property="Foreground" Value="#001433"></Setter>
        <Setter Property="CornerRadius" Value="20"></Setter>
        <Setter Property="MinWidth" Value="80"></Setter>
        <Setter Property="MinHeight" Value="30"></Setter>
        <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
        <Setter Property="Cursor" Value="Hand"></Setter>
        <Setter Property="Margin" Value="20"></Setter>
        
    </Style>
    <Style Selector="Button TextBlock">
        <Setter Property="TextAlignment" Value="Center"></Setter>
    </Style>
    <Style Selector="Button /template/ ContentPresenter">
        <Setter Property="BorderBrush" Value="Transparent"></Setter>
        <Setter Property="Background" Value="#CCE0FF"></Setter>
        <Setter Property="Transitions">
        <Transitions>
            <BrushTransition  Property="BorderBrush" Duration="0:0:0.5"/>
            <BrushTransition  Property="Background" Duration="0:0:0.5"/>
        </Transitions>
        </Setter>
        
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">

        <Setter Property="BorderBrush" Value="#001433"></Setter>
        <Setter Property="Background" Value="white"></Setter>
    </Style>
    <!-- add button -->
    <Style Selector="Button.Add"> 
        <Setter Property="Background" Value="Transparent"></Setter>
        <Setter Property="BorderBrush" Value="Transparent"></Setter>
    </Style>
    <Style Selector="Button.Add:pointerover /template/ ContentPresenter"> 
        <Setter Property="Background" Value="Transparent"></Setter>
        <Setter Property="BorderBrush" Value="Transparent"></Setter>
    </Style>
    
    
    <!-- Add Styles Here -->
</Styles>
