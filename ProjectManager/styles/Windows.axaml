<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <Border CornerRadius="10">
                <Grid RowDefinitions="* 3* * *" Background="#E5F0FF" RowSpacing="120" >
                    <Viewbox  HorizontalAlignment="Right">
                    <Button Height="26" Width="26" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Right" x:Name="Close">x</Button>
                    </Viewbox>
                    <Viewbox Grid.Row="1" >
                        <Calendar Grid.Row="1" 
                                  x:Name="DeadLineDate"
                        />
                    </Viewbox>
       
                    <TextBox Grid.Row="2" x:Name="ProjectName"></TextBox>
                    <Button Grid.Row="3" HorizontalAlignment="Center" x:Name="Button"   >Add This Project</Button>
        
        
        
                </Grid>
            </Border>
        </Border>
    </Design.PreviewWith>

    <!-- Add Styles Here -->
    <Style Selector="Border">
        <Setter Property="CornerRadius" Value="5"></Setter>
    </Style>
</Styles>
