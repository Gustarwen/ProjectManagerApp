<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
      
            <!-- Add Controls for Previewer Here -->
            <Grid  ColumnDefinitions="Auto Auto Auto" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Grid.Column="0" Background="{DynamicResource RedFive}" Width="60"  Height="60" Foreground="white" FontSize="40" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"  CornerRadius="30">-</Button>
                <Border Grid.Column="1" Height="60" Margin="10" Padding="15" ><TextBlock >hello jak se mate ja se mam fajnove</TextBlock></Border>
                <Button Grid.Column="2" Width="60" Height="60" CornerRadius="30" Background="{DynamicResource GreenTwo}" FontSize="40" Foreground="white" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">+</Button>
                
            </Grid>
      
    </Design.PreviewWith>
    <!--text block-->
    <Style Selector="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="Height" Value="20"></Setter>
        <Setter Property="TextAlignment" Value="Center"></Setter>
        <Setter Property="Foreground" Value="White"></Setter>
        
    </Style>
    
    <Style Selector="Border">
        <Setter Property="Background" Value="{DynamicResource BlueOne}"></Setter>
        <Setter Property="CornerRadius" Value="30"></Setter>
        
    </Style>
   <!--delete button-->
    
   <!--add button-->
   
    <!-- Add Styles Here -->
    
   
 


</Styles>
