<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProjectManager.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ProjectManager.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        
        
        Icon="/Assets/avalonia-logo.ico"
        Title="ProjectManager">
        <Window.Styles>
            <StyleInclude Source="../styles/style.axaml"></StyleInclude>
        </Window.Styles>
    <Design.DataContext>
      
        <vm:MainViewModel />
    </Design.DataContext>

   <Grid  RowDefinitions="Auto,Auto,*,auto" ColumnDefinitions="200,*" >
      
           
  
       <StackPanel VerticalAlignment="Center" Grid.RowSpan="4">
           <Button   Grid.Row="2" Command="{Binding GoToHomeCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"  VerticalContentAlignment="Center"     Content="Home"></Button>
           <Button   Grid.Row="1" Command="{Binding GoToQaACommand}" HorizontalAlignment="Stretch"  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"    Content="QaA"></Button>
          
       </StackPanel>
       
       <ContentControl Grid.Column="1" Grid.RowSpan="3" Content="{Binding  CurrentPage}"></ContentControl>
       <Button Grid.Row="3" Content="Settings" Command="{Binding OpenSettingDialogCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"></Button>
   </Grid>

</Window>