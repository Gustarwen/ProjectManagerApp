<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProjectManager.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ProjectManager.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        
        
        Icon="/Assets/avalonia-logo.ico"
        Title="ProjectManager">

    <Design.DataContext>
      
        <vm:MainViewModel />
    </Design.DataContext>

   <Grid RowDefinitions="Auto,Auto,Auto" >
       <TextBlock  Text="Hello in Project Manager">
           
       </TextBlock>
       
       <Button Grid.Row="1" Command="{Binding GoToQaACommand}" VerticalContentAlignment="Center"  HorizontalContentAlignment="Center" Width="300" Height="300" Content="This is my buttoN"></Button>
       <ContentControl Grid.Row="2" Content="{Binding  CurrentPage}"></ContentControl>
   </Grid>

</Window>
