<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             
             x:Class="ProjectManager.Views.ProjectBoardView"
             xmlns:vm="clr-namespace:ProjectManager.ViewModels"
             x:DataType="vm:ProjectBoardViewModel"
             
             >

        <Grid ColumnDefinitions="* *" RowDefinitions="2* 3*" Background="#E5F0FF" MinWidth="200" MinHeight="300">
            <Border ClipToBounds="True" >
                  <Viewbox >
                    <ContentControl x:Name = "MyAccept"  Content="{Binding Piegraph}" Margin="10" Height="500" Width="500"></ContentControl>
                  </Viewbox>
            </Border>
            <Border Grid.Column="1" Background="#99C2FF" ClipToBounds="True">
            <Viewbox>
                    <ContentControl  x:Name="AcceptInTime"  Content="{Binding Blockgraph}" Margin="10" Height="300" Width="300"></ContentControl>
            </Viewbox>
            </Border>
           
            
            <ContentControl Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"  Content="{Binding Selected }"></ContentControl>
        </Grid>

   
   
        

</UserControl>
