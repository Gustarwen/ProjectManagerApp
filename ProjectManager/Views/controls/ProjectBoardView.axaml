<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ProjectManager.Views.ProjectBoardView"
             xmlns:vm="clr-namespace:ProjectManager.ViewModels"
             x:DataType="vm:ProjectBoardViewModel"
             >
    <ScrollViewer VerticalScrollBarVisibility="Visible">
        <StackPanel>
            <Border x:Name="DashBoard">
                <WrapPanel>
                    <Grid RowDefinitions="Auto Auto" VerticalAlignment="Top" Height="300">
                        <ContentControl VerticalAlignment="Top"  Content="{Binding Graph}" Margin="10" Height="50" Width="300"> </ContentControl>
                        <ContentControl Grid.Row="1" VerticalAlignment="Top"  Content="{Binding Graph}" Margin="10" Height="50" Width="300"> </ContentControl>
                    </Grid>
                  
                    <ContentControl x:Name = "MyAccept"  Content="{Binding Piegraph}" Margin="10" Height="200" Width="200"></ContentControl>
                   
                    <ContentControl x:Name="AcceptInTime"  Content="{Binding Blockgraph}" Margin="10" Height="300" Width="300"></ContentControl>
                    
                </WrapPanel>
                
                
            </Border>
            
            <ContentControl  Content="{Binding Selected }"></ContentControl>
        </StackPanel>
    </ScrollViewer>
   
   
        

</UserControl>
