<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ProjectManager.Views.ProjectBoardView"
             xmlns:vm="clr-namespace:ProjectManager.ViewModels"
             x:DataType="vm:ProjectBoardViewModel"
             >
    <ScrollViewer VerticalScrollBarVisibility="Visible">
        <StackPanel>
            <Border x:Name="DashBoard"  MaxWidth="300">
                <WrapPanel>
                    
                    <ContentControl  Content="{Binding Graph}" Margin="10" Height="100" Width="600"> </ContentControl>
                    <ContentControl  Content="{Binding Piegraph}" Margin="10" Height="200" Width="200"></ContentControl>
                    
                </WrapPanel>
                
                
            </Border>
            
            <ContentControl  Content="{Binding Selected }"></ContentControl>
        </StackPanel>
    </ScrollViewer>
   
   
        

</UserControl>
