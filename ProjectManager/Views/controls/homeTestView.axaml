<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="450"
             x:Class="ProjectManager.Views.homeTestView"
             xmlns:local = "clr-namespace:ProjectManager.Views" Padding="10">

    <Grid RowDefinitions="Auto 3* 2*" Background="White">
        <!-- welcome sign -->
        <Viewbox  Stretch="Uniform" Width="300">
            <TextBlock TextAlignment="Center" x:Name="welcome" > Good Morning</TextBlock>
        </Viewbox>
        
        
        <Grid Grid.Row="1" ColumnDefinitions="3* 2*">
            <!-- tasks -->
            <Border   ClipToBounds="True"  Margin="10" x:Name="TaskBorder"  MinWidth="300">
                <Grid RowDefinitions="Auto *">
                 
                   
                        <TextBlock TextAlignment="Center" FontSize="30" DockPanel.Dock="Top" Classes="cardTitle" Text="Tasks"/>
                       
                        <local:TasksView Grid.Row="1" x:Name="TasksView"/>
                    
                    
                 
                
           
           
                </Grid>
            </Border>
            <Border Grid.Column="2"   Margin="10" ClipToBounds="True" VerticalAlignment="Top" x:Name="Statistics">
                <Grid ColumnDefinitions="* *" RowDefinitions="Auto *" MinWidth="300">
                    <TextBlock Grid.ColumnSpan="2" DockPanel.Dock="Top" FontSize="30" TextAlignment="Center">Statistics</TextBlock>
                    <Viewbox  Grid.Row="1"  Margin="30" >
                        <local:blockGraphView Height="200" Width="150"></local:blockGraphView>
                    </Viewbox>
                    <Viewbox Grid.Row="1" Grid.Column="1"  Margin="30" >
                        <local:piegraphView Width="500" Height="500"></local:piegraphView>
                    </Viewbox>
                </Grid>
            </Border>
        </Grid>
            
       
        
        <!-- projects -->
        <Border Grid.Row="2"  Margin="10" ClipToBounds="True" MinHeight="200">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <Grid RowDefinitions="Auto *" >
              
                <TextBlock FontSize="30" Text="Projects" ></TextBlock>
            
                <StackPanel Grid.Row="1"  Orientation="Horizontal" HorizontalAlignment="Stretch" Spacing="50" VerticalAlignment="Top" x:Name="ProjectPanels">
    
                
            </StackPanel>
            </Grid>
            </ScrollViewer>
        </Border >
    </Grid>

    <UserControl.Styles>
        <StyleInclude Source="../../styles/HomeViewStyle.axaml"></StyleInclude>
    </UserControl.Styles>
</UserControl>
