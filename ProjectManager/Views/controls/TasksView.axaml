<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ProjectManager.Views.TasksView">
   <StackPanel>
       <Grid ColumnDefinitions="Auto Auto Auto Auto * Auto">
           <Button>all</Button>
           <Button Grid.Column="1">issues</Button>
           <Button Grid.Column="2">milestones</Button>
           <Button Grid.Column="3">in progress</Button>
           <Viewbox Grid.Column="5" Height="200">
               <Button  Classes="Add" FontWeight="ExtraBold">+</Button>
           </Viewbox>
           
           
       </Grid>
       <Border ClipToBounds="True">
       <ScrollViewer VerticalScrollBarVisibility="Visible">
       <StackPanel Spacing="10">
           <Border Margin="50 0" Height="60" BorderBrush="#0063CC" BorderThickness="2">
               <Grid ColumnDefinitions="Auto Auto * Auto Auto">
                   <Viewbox Height="50">
                   <CheckBox Margin="10 0"></CheckBox>
                   </Viewbox>
                   <Viewbox Grid.Column="1" Height="50">
                       <TextBlock> hej</TextBlock>
                   </Viewbox>
                   <Viewbox Grid.Column="3" Height="50">
                       <Button Margin="10 0" Height="20" Width="20" MinWidth="20" CornerRadius="2" Background="#FFCCCC"></Button>
                   </Viewbox>
                   <Viewbox Grid.Column="4" Height="50" >
                       <Button Margin="10 0" Height="20" Width="20" MinWidth="20" CornerRadius="2"></Button>
                   </Viewbox>
               </Grid>
           </Border>
           <Border Margin="50 0" Height="60" BorderBrush="#0063CC" BorderThickness="2">
               <Grid ColumnDefinitions="Auto Auto * Auto Auto">
                   <Viewbox Height="50">
                       <CheckBox Margin="10 0"></CheckBox>
                   </Viewbox>
                   <Viewbox Grid.Column="1" Height="50">
                       <TextBlock> hej</TextBlock>
                   </Viewbox>
                   <Viewbox Grid.Column="3" Height="50">
                       <Button Margin="10 0" Height="20" Width="20" MinWidth="20" CornerRadius="2" Background="#FFCCCC"></Button>
                   </Viewbox>
                   <Viewbox Grid.Column="4" Height="50" >
                       <Button Margin="10 0" Height="20" Width="20" MinWidth="20" CornerRadius="2"></Button>
                   </Viewbox>
               </Grid>
           </Border>
           <Border Margin="50 0" Height="60" BorderBrush="#0063CC" BorderThickness="2">
               <Grid ColumnDefinitions="Auto Auto * Auto Auto">
                   <Viewbox Height="50">
                       <CheckBox Margin="10 0"></CheckBox>
                   </Viewbox>
                   <Viewbox Grid.Column="1" Height="50">
                       <TextBlock> hej</TextBlock>
                   </Viewbox>
                   <Viewbox Grid.Column="3" Height="50">
                       <Button Margin="10 0" Height="20" Width="20" MinWidth="20" CornerRadius="2" Background="#FFCCCC"></Button>
                   </Viewbox>
                   <Viewbox Grid.Column="4" Height="50" >
                       <Button Margin="10 0" Height="20" Width="20" MinWidth="20" CornerRadius="2"></Button>
                   </Viewbox>
               </Grid>
           </Border>
           <Border Margin="50 0" Height="60" BorderBrush="#0063CC" BorderThickness="2">
               <Grid ColumnDefinitions="Auto Auto * Auto Auto">
                   <Viewbox Height="50">
                       <CheckBox Margin="10 0"></CheckBox>
                   </Viewbox>
                   <Viewbox Grid.Column="1" Height="50">
                       <TextBlock> hej</TextBlock>
                   </Viewbox>
                   <Viewbox Grid.Column="3" Height="50">
                       <Button Margin="10 0" Height="20" Width="20" MinWidth="20" CornerRadius="2" Background="#FFCCCC"></Button>
                   </Viewbox>
                   <Viewbox Grid.Column="4" Height="50" >
                       <Button Margin="10 0" Height="20" Width="20" MinWidth="20" CornerRadius="2"></Button>
                   </Viewbox>
               </Grid>
           </Border>
     


       </StackPanel>
       </ScrollViewer>
       </Border>
   </StackPanel>
    
    <UserControl.Styles>
        <StyleInclude Source="../../styles/TaskStyles.axaml"></StyleInclude>
    </UserControl.Styles>
</UserControl>
