<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ProjectManager.Views.QaAView">
        <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <TextBlock Classes="header" HorizontalAlignment="Center"  Text="Q&amp;A"></TextBlock>
            
            <Border Classes="question">
                <TextBlock Classes ="question" Text="Why use this application?"></TextBlock>
            </Border>
            <Border Classes="answer">
            <TextBlock Classes ="answer" Text="This application will help you manage your precious time more effectively. At the same time, it will assist people facing the same problem I once had—namely, completing their projects."></TextBlock>
            </Border>
            <Border Classes="question">
            <TextBlock Classes ="question" Text="Who are you?"></TextBlock>
                </Border>
            <Border Classes="answer">
            <TextBlock Classes ="answer" Text="I am Gustarwen. A silly developer."></TextBlock>
                </Border>
        </StackPanel>
    
</UserControl>
