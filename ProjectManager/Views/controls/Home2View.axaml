<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:localv="clr-namespace:ProjectManager.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ProjectManager.Views.Home2View">
    <UserControl.Styles>
        <StyleInclude Source="../../styles/HomeViewStyle.axaml"></StyleInclude>
    </UserControl.Styles>
    <Border Background="#F8F9FA">
 
        <Grid RowDefinitions="* * Auto">
                <StackPanel Width="100">
                   
                </StackPanel>
                <Border  Background="#DEE2E6" BorderBrush="#ADB5BD" BorderThickness="4 1"></Border>
                <Border   Grid.Row="1" Background="#DEE2E6" BorderBrush="#ADB5BD" BorderThickness="4 1" ClipToBounds="True">
                    <Grid ColumnDefinitions="* *">
                        <ScrollViewer Padding="20" Grid.Column="0">
                        <StackPanel x:Name = "TaskPanel" HorizontalAlignment="Stretch">
                            <TextBlock Margin="10" Foreground="Black"> Tasks</TextBlock>
                         
                            
                            
                        </StackPanel>
                        </ScrollViewer>
                         <localv:blockGraphView Margin="10 " Grid.Column="1"></localv:blockGraphView>
                    </Grid>
                </Border>
                <!--projects list-->

                <Border Grid.Column="1" Grid.Row="2" Background="#DEE2E6" BorderBrush="#ADB5BD" BorderThickness="4 1">
                    <StackPanel>
                    <Grid  ColumnDefinitions="Auto * Auto">
                        <TextBlock>projects</TextBlock>
                        <Button Grid.Column="2" x:Name = "AddProject">add task</Button>
                    </Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name = "ProjectPanel" Orientation="Horizontal">
                         
                        </StackPanel>
                    </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        
</UserControl>
