<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:localv="clr-namespace:ProjectManager.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ProjectManager.Views.Home2View">
    <UserControl.Styles>
        <StyleInclude Source="../../styles/HomeViewStyle.axaml"></StyleInclude>
    </UserControl.Styles>
    <Border Background="#E5F0FF">
 
        <Grid RowDefinitions="* * Auto">

                <Border  Background="#CCE0FF" >
                    <Grid ColumnDefinitions="* * *" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
          
                       
                    
                        
                        <Viewbox Grid.Column="0" Stretch="Uniform">
                            <Grid Width="400" Height="250">
                                <Border Margin="50" BoxShadow="4 6 50 -10 #000E24"
                                        Background="#E5F0FF" CornerRadius="30">
                                    <Grid RowDefinitions="* *">
                                        <Viewbox>
                                            <TextBlock>5</TextBlock>
                                        </Viewbox>
                                        <Viewbox Grid.Row="1" VerticalAlignment="Bottom" Margin="10">
                                            <TextBlock Text="finished tasks"/>
                                        </Viewbox>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Viewbox>
                        <Viewbox Grid.Column="1" Stretch="Uniform">
                            <Grid Width="400" Height="250">
                                <Border Margin="50" BoxShadow="4 6 50 -10 #000E24"
                                        Background="#E5F0FF" CornerRadius="30">
                                    <Grid RowDefinitions="* *">
                                        <Viewbox>
                                            <TextBlock>5</TextBlock>
                                        </Viewbox>
                                        <Viewbox Grid.Row="1" VerticalAlignment="Bottom" Margin="10">
                                            <TextBlock Text="finished tasks"/>
                                        </Viewbox>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Viewbox>
                        <Viewbox Grid.Column="2" Stretch="Uniform">
                            <Grid Width="400" Height="250">
                                <Border Margin="50" BoxShadow="4 6 50 -10 #000E24"
                                        Background="#E5F0FF" CornerRadius="30">
                                    <Grid RowDefinitions="* *">
                                        <Viewbox>
                                            <TextBlock>5</TextBlock>
                                        </Viewbox>
                                        <Viewbox Grid.Row="1" VerticalAlignment="Bottom" Margin="10">
                                            <TextBlock Text="finished tasks"/>
                                        </Viewbox>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Viewbox>
                        
                       
                        

                    </Grid>
                </Border>
                <Border   Grid.Row="1" Background="#E5F0FF"  ClipToBounds="True">
                    <Grid ColumnDefinitions="* *">
                        <Viewbox Margin="0 20" Stretch="Uniform">
                            <Border BorderBrush="Black" BorderThickness="1" CornerRadius="50" Height="900" Width="900 " Padding="10">
                                <localv:piegraphView ></localv:piegraphView>
                            </Border>
                        </Viewbox>
                        <Viewbox Grid.Column="1" Margin="0 20" Stretch="Fill">
                            
                                <ContentControl BorderBrush="Black" BorderThickness="1" CornerRadius="5" Height="300" Width="600 ">
                                    <localv:blockGraphView Margin="10 5 0 5" Grid.Column="1"></localv:blockGraphView>
                                </ContentControl>
                               
                      
                        </Viewbox>
                       
                       
                         
                    </Grid>
                </Border>
                <!--projects list-->

                <Border Grid.Column="1" Grid.Row="2" Background="#DEE2E6" BorderBrush="#ADB5BD" BorderThickness="4 1">
                    <StackPanel>
                    <Grid  ColumnDefinitions="Auto * Auto">
                        <TextBlock>projects</TextBlock>
                        <Button Grid.Column="2" x:Name = "AddProject">add task</Button>
                    </Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name = "ProjectPanel" Orientation="Horizontal">
                         
                        </StackPanel>
                    </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        
</UserControl>
