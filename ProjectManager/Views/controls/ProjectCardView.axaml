<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ProjectManager.Views.ProjectCardView">
        <Border Background="#F8F9FA" Width="200" Height="350" CornerRadius="20" ClipToBounds="True">
            <StackPanel >
                <Grid>
                    <Image Height="160" Source="../../Images/noImageIcon.png"></Image>
                    <Border Background="#6196FF" Height="30" CornerRadius="20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="5"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#F8F9FA">In Progress</TextBlock></Border>
                </Grid>
                
                <TextBlock TextAlignment="Center" FontSize="18">Project</TextBlock>
                <Grid Height="130" Margin="10 10 10 0"  ColumnDefinitions="* *">
                    <Border Background="#CED4DA" BorderBrush="#6C757D" BorderThickness="2" CornerRadius="5">
                        <TextBlock VerticalAlignment="Center" TextAlignment="Center" FontSize="35" TextWrapping="Wrap" >38 days</TextBlock>
                    </Border>
                    <Grid Grid.Column="1" RowDefinitions="* *">
                        <Border  Background="#CED4DA" BorderBrush="#6C757D" BorderThickness="2" CornerRadius="5">
                            <TextBlock VerticalAlignment="Center" TextAlignment="Center" FontSize="30" TextWrapping="Wrap" >100%</TextBlock>
                        </Border>
                        <Border Grid.Row="1"  Background="#CED4DA" BorderBrush="#6C757D" BorderThickness="2" CornerRadius="5">
                            <TextBlock VerticalAlignment="Center" TextAlignment="Center" FontSize="15" TextWrapping="Wrap" >19.6.2026</TextBlock>
                        </Border>
                    </Grid>
                    
                </Grid>
                <ProgressBar VerticalAlignment="Bottom" Margin="10 20" Value="75"></ProgressBar>
            </StackPanel >
        </Border>
    
</UserControl>
