<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ProjectManager.Views.ProjectCardView">
    <Button x:Name="GoToProject" Background="Transparent" Padding="3">
   <Viewbox>

       <Border DragDrop.AllowDrop="True" DragDrop.Drop = "OnDrop" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"  Background="#F8F9FA" Width="220" Height="180"  ClipToBounds="True" Padding="0" BorderThickness="0" x:Name="ProjectBorder">
           
            <Border.ContextFlyout>
                <MenuFlyout>
                    <MenuItem Name="Delete" x:Name="Delete"/>
                </MenuFlyout>
            </Border.ContextFlyout>
           <StackPanel>
              
               <Grid>
                   <!-- Místo <Image> použijeme Border s kulatými horními rohy -->
                  <Image x:Name="ProjectBitMap" Stretch="UniformToFill" MaxHeight="60"></Image>
                            
                   <Border x:Name="State" Background="#0077b6" Height="40" CornerRadius="20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="5"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#F8F9FA">In Progress</TextBlock></Border>
               </Grid>
                   
               <TextBlock x:Name="Name" TextAlignment="Center" Foreground="Black" FontSize="18">Project</TextBlock>
               <Grid ColumnDefinitions="* *"  Height="70">
                   <Border Grid.Column="0" VerticalAlignment="Center">
                       <TextBlock TextAlignment="Center" Foreground="Black">hello</TextBlock>
                   </Border>
                   <Border Grid.Column="1" VerticalAlignment="Center">
                       <TextBlock TextAlignment="Center" Foreground="Black">fellow</TextBlock>
                   </Border>
               </Grid>
                   
               <ProgressBar  x:Name="ProgressBar" Foreground="#0077b6" VerticalAlignment="Bottom"  Value="75"></ProgressBar>
           </StackPanel >
        
       </Border>

       
   </Viewbox>
   </Button>
    
   
   <UserControl.Styles>
       <StyleInclude Source="../../styles/HomeViewStyle.axaml"></StyleInclude>
   </UserControl.Styles>

</UserControl>
