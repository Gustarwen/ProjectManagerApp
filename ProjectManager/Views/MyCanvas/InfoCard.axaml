<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ProjectManager.Views.MyCanvas.InfoCard">
    <Border Background="#E5F0FF" Height="200" Width="400" BoxShadow="4 6 20 0 #000E24" CornerRadius="50">
        <Viewbox >
            <StackPanel >
            <TextBlock TextAlignment="Center" Foreground="#FF0000">5</TextBlock>
            <TextBlock Foreground="#FF3333">Issues</TextBlock>
            </StackPanel>
        </Viewbox>
       
    </Border>
</UserControl>
