<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ProjectManager.Views.milestone">
    <Grid Height="200" Width="150" RowDefinitions="* Auto">
        <Polygon Height="150" Width="150" Points="0 5,5 10,10 5, 5 0" StrokeThickness="5" Stroke="#530066" Fill="#F6CCFF"  Stretch="Fill"></Polygon>
        <TextBlock Text="V 1.0" FontSize="25" Grid.Row="1" TextAlignment="Center" VerticalAlignment="Center"/>
        <Grid.ContextFlyout>
          
            <MenuFlyout  >
                
                <MenuItem Header="Import file..."   />
                <MenuItem Header="Connect onto other..."  x:Name="ConnectButton" />
                <MenuItem Header="Mark as In Progress.."  x:Name="MarkAsInProgress"  />
                <MenuItem Header="Mark as Issue"  x:Name="MarkAsIssue" />
                <MenuItem Header="Mark as Finished" x:Name = "Accept"  />
                <Separator/>
                <MenuItem Header="Open"          />
                <MenuItem Header="Create" x:Name="Add"></MenuItem>
                <MenuItem Header="Delete"      x:Name="Delete"   />
            </MenuFlyout>
        </Grid.ContextFlyout>
    </Grid>
       
   
</UserControl>
