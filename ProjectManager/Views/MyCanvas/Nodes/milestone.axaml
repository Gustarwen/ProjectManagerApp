<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ProjectManager.Views.milestone">
    <Grid Height="250" Width="200" RowDefinitions="* Auto">
        <Polygon Height="200" Width="200" Points="0 5,5 10,10 5, 5 0" StrokeThickness="5" Stroke="#bc00dd" Fill="#5a189a" Opacity="0.75" Stretch="Fill"></Polygon>
        <TextBlock Text="V 1.0" FontSize="25" Grid.Row="1" TextAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
       
   
</UserControl>
