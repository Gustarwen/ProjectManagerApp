<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ProjectManager.Views.Issue">
    <Grid Width="200" RowDefinitions="* Auto" Height="90">
        <Grid ColumnDefinitions="Auto *">
            <Ellipse Fill="#370617" Height="20" Width="20" Stroke="#e85d04" StrokeThickness="2"></Ellipse>
            <Rectangle Grid.Column="1"
                   
                       Stretch="Fill"
                       Fill="#370617"
                       Opacity="0.75"
                       Stroke="#e85d04" StrokeThickness="2"
                       StrokeJoin="Round"/>
        </Grid>
       
        
        
     
        
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxWidth="150">
            <TextBlock Text="" FontSize="15"/>
        </Viewbox>
        <Grid.ContextFlyout>
          
            <MenuFlyout  >
                
                <MenuItem Header="Import file..."   />
                <MenuItem Header="Mark as Issue"    />
                <MenuItem Header="Mark as Milestone"   />
                <Separator/>
                <MenuItem Header="Open"          />
                <MenuItem Header="Create"></MenuItem>
                <MenuItem Header="Delete"         />
            </MenuFlyout>
        </Grid.ContextFlyout>
        
    </Grid>
</UserControl>
