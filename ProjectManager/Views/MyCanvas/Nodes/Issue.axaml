<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ProjectManager.Views.Issue">
    <Grid Width="150" RowDefinitions="* Auto" Height="50" >
        
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderBrush="#660000" BorderThickness="5" CornerRadius="20" ClipToBounds="True" Padding="5" Background="#FFCCCC">
            <Grid ColumnDefinitions="Auto *">
                <Ellipse Grid.Column="0" Height="20" Width="20" Stroke="#660000" StrokeThickness="4" Margin="5"/>
                <Ellipse Grid.Column="0" Height="9" Width="9" Fill="#660000" StrokeThickness="4" />
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Visible" >
                    <TextBlock  VerticalAlignment="Center" TextAlignment="Center" Text="Issue with adding some random file"></TextBlock>
                </ScrollViewer>
            </Grid>
           
        </Border>
        
        
     
        
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxWidth="150">
            <TextBlock Text="" FontSize="15"/>
        </Viewbox>
        <Grid.ContextFlyout>
          
            <MenuFlyout  >
                
                <MenuItem Header="Import file..."   />
                <MenuItem Header="Connect onto other..."  x:Name="ConnectButton" />
                <MenuItem Header="Mark as In Progress.."   x:Name="MarkAsInProgress" />
                <MenuItem Header="Mark as Milestone"  x:Name="MarkMilestone" />
                <MenuItem Header="Mark as Finished" x:Name = "Accept"  />
                <Separator/>
                <MenuItem Header="Open"          />
                <MenuItem Header="Create" x:Name="Add"></MenuItem>
                <MenuItem Header="Delete"      x:Name="Delete"   />
            </MenuFlyout>
        </Grid.ContextFlyout>
        
    </Grid>
</UserControl>
