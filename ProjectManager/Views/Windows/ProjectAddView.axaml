<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="500"
        CornerRadius="20"
        CanResize="False"
        x:Class="ProjectManager.Views.Windows.ProjectAddView"
        Height="400"
        Width="350"
       WindowStartupLocation="CenterScreen"
        Title="ProjectAdd"
        xmlns:vm="clr-namespace:ProjectManager.ViewModels"
        SystemDecorations="None"
        Background="Transparent"
        x:DataType="vm:ProjectAddViewModel"
        >
    <Border Padding="20" Background="#E5F0FF" BorderBrush="blue" ClipToBounds="True" CornerRadius="20" >

            <Grid RowDefinitions="Auto 3* Auto Auto" RowSpacing="10" >
                <Viewbox  HorizontalAlignment="Right" Height="30" Width="30">
                    <Button Height="26" Width="26" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Right" x:Name="Close">x</Button>
                </Viewbox>
                <Viewbox Grid.Row="1" >
                    <Calendar Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              x:Name="DeadLineDate"
                    />
                </Viewbox>
       
                <TextBox Grid.Row="2" CornerRadius="20" Watermark="Name Of Task"  x:Name="ProjectName"></TextBox>
                <Button Grid.Row="3" HorizontalAlignment="Center" x:Name="Button"   >Add This Project</Button>
        
        

            </Grid>

    </Border>
   
</Window>
