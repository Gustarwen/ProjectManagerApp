<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="500"
        CornerRadius="20"
        CanResize="False"
        x:Class="ProjectManager.Views.Windows.ProjectAddView"
        Height="200"
        Width="100"
        Title="ProjectAdd"
        xmlns:vm="clr-namespace:ProjectManager.ViewModels"
        x:DataType="vm:ProjectAddViewModel"
        >
    <StackPanel>
        <CalendarDatePicker 
                            x:Name="DeadLineDate"
                            SelectedDateFormat="Custom"
                            CustomDateFormatString="d. M. yyyy"
                            HorizontalAlignment="Stretch"
                            Watermark="Vyberte termín" />
        <TextBox x:Name="ProjectName"></TextBox>
        <Button HorizontalAlignment="Center" x:Name="Button"   >Add This Project</Button>
        
        
        
    </StackPanel>
   
</Window>
