<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ProjectManager.Views.HomeView"
             xmlns:vm="clr-namespace:ProjectManager.ViewModels"
             x:DataType="vm:HomeViewModel"
             xmlns:data ="clr-namespace:ProjectManager.DataTemplates"
             xmlns:view="clr-namespace:ProjectManager.Views">
    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <TextBox x:Name = "Name" Grid.Row="0" Text="{Binding Names}" Watermark="Name"></TextBox>
        <DatePicker   x:Name="DatePicker1" Grid.Row="1" SelectedDate="{Binding Dates}"></DatePicker>
        <Button  Grid.Row="2" Command="{Binding AddPropertyCommand}"  Content="Add Property"/>
        <ListBox Grid.Row="3" ItemsSource="{Binding Mydata}" ScrollViewer.VerticalScrollBarVisibility="Visible">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="auto,auto,*,Auto,Auto">
                        <TextBlock  Text="{Binding Name}"/>
                        <Button Grid.Column="3" Background="LightGreen">Accept</Button>
                        <Button Grid.Column="4" Background="LightCoral">Delete</Button>
                    </Grid>
                   
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

            
                
          
            
        
    </Grid>

</UserControl>
