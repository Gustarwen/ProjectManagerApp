<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ProjectManager.Views.HomeView"
             xmlns:vm="clr-namespace:ProjectManager.ViewModels"
             x:DataType="vm:HomeViewModel"
             xmlns:view="clr-namespace:ProjectManager.Views">
    <UserControl.Styles>
        <StyleInclude Source="../styles/style.axaml"></StyleInclude>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <TextBox x:Name = "Name" Grid.Row="0" Text="{Binding Names}" Watermark="Name"></TextBox>
        <DatePicker   x:Name="DatePicker1" Grid.Row="1" SelectedDate="{Binding Dates}"></DatePicker>
        <Button  Grid.Row="2" Command="{Binding AddPropertyCommand}"  Content="Add Property"/>
        
        <ListBox  Grid.Row="3" ItemsSource="{Binding Mydata}" ScrollViewer.VerticalScrollBarVisibility="Visible" >
            <ListBox.Styles>
                <Style Selector="Grid.finished">
                    <Setter Property="Background" Value="LightGreen"></Setter>
                </Style>
                
            </ListBox.Styles>
           
            <ListBox.ItemTemplate >
                <DataTemplate>
               
                       <Button x:Name="ProjectButton"  Command="{Binding $parent[view:MainWindow].((vm:MainViewModel)DataContext).GoToProjectBoardCommand}"  CommandParameter="{Binding}">
                           <Border Grid.ColumnSpan="5" Padding="150" Classes.finished="{Binding Finished }">
                            
                               <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" >
                                   <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                   <Button  HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Command="{Binding $parent[ListBox].DataContext.AcceptCommand}" 
                                            CommandParameter="{Binding}" Classes="accept" Content="Accept"></Button>
                                   <Button Grid.Column="4"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Command="{Binding $parent[ListBox].DataContext.DeletePropertyCommand, x:DataType=vm:HomeViewModel}" 
                                           CommandParameter="{Binding}">Delete</Button>
                               </StackPanel>
                           </Border>
                           
                       </Button>
                        
                        
                    
                   
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"></WrapPanel>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
        

            
                
          
            
        
    </Grid>

</UserControl>
