<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ProjectManager.Views.NodConfiguration"
        xmlns:vm ="clr-namespace:ProjectManager.ViewModels"
        x:DataType="vm:CanvasNodesViewModel"
        Title="NodConfiguration">
        <StackPanel>
                <TextBox x:Name="NameBox" Watermark="name of task"></TextBox>
                <DatePicker x:Name="MyDatePicker"></DatePicker>
                <Button x:Name="Accept">Add Task</Button>
                
        </StackPanel>
</Window>
