<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ProjectManager.Views.connectNodes"
        xmlns:vm = "clr-namespace:ProjectManager.ViewModels"
        x:DataType="vm:connectNodesViewModel"
        Title="connectNodes">
        <ListBox ItemsSource="{Binding Tasks}">
                <ListBox.ItemTemplate>
                        <DataTemplate>
                                <Grid ColumnDefinitions="* * *" Height="30">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" ></TextBlock>
                                        <TextBlock Grid.Column="1" Text="{Binding ProjectName}"></TextBlock>
                                        <Button Grid.Column="2" Command="{Binding $parent[ListBox].DataContext.AddConnectionCommand, x:DataType=vm:HomeViewModel}" >Connect</Button>
                                        
                                        
                                </Grid>
                        </DataTemplate>
                </ListBox.ItemTemplate>
        </ListBox>
</Window>
